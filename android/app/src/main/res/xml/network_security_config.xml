<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The tunnel itself talks to its endpoints over their own TLS; the app
         makes no cleartext calls. Keep cleartext disabled by default. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
